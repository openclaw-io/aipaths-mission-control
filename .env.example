# Required runtime database. Safety-sensitive scripts accept only the exact
# loopback database aipaths_mission_control_local and never fall back to cloud.
MISSION_CONTROL_DATABASE_URL=postgres://aipaths_mc_app@127.0.0.1:5432/aipaths_mission_control_local

# Explicit opt-in for this private local runtime. Leave false/unset anywhere
# authentication should remain enabled.
MISSION_CONTROL_LOCAL_AUTH_DISABLED=true

# Spanish-only blog final package cutover. Disabled by default; GON-154 owns
# runtime activation/canary. When enabled, the local runtime creates ES-only
# final-package work instead of new EN localization work.
SPANISH_ONLY_BLOG_FINAL_PACKAGE_ENABLED=false

# Repository security boundary. By default Mission Control derives the services
# root from its cwd and adds AIPATHS_AGENTS_DIR when declared. Override the full
# list only for exceptional layouts; use the platform path delimiter (`:` on macOS).
AIPATHS_AGENTS_DIR=/path/to/workspace/agents
# AIPATHS_REPOSITORY_ROOTS=/path/to/services:/path/to/workspace/agents

# Supabase remains available for auth and as the read-only source of the
# one-time local bootstrap. SUPABASE_SERVICE_ROLE_KEY is not a runtime DB fallback.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: distinct website Supabase DB for Email Campaign metrics/audience snapshot.
WEBSITE_SUPABASE_URL=your-website-supabase-url
WEBSITE_SUPABASE_SERVICE_ROLE_KEY=your-website-service-role-key
AGENT_API_KEY=your-internal-agent-api-key
OPENCLAW_GATEWAY_TOKEN=your-openclaw-gateway-token
DISCORD_TASK_ROUTER_WEBHOOK=https://discord.com/api/webhooks/...
